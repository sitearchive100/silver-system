<body>

<div class="container">

    <div class="header">
        SCP: CONTAINMENT PROTOCOL // ACCESS TERMINAL
    </div>

    <div class="classified">
        DOCUMENTO CLASSIFICADO // LEVEL 3 CLEARANCE
    </div>


    <div class="warning">

        <b>AVISO DE SEGURANÇA:</b><br>

        Você está solicitando acesso temporário ao programa
        de demonstração do projeto.

    </div>


    <div class="instructions">

        <h2>PROCEDIMENTO DE AUTORIZAÇÃO</h2>

        <p>
            Para obter o <strong>código de acesso à demonstração</strong>,
            copie a mensagem de concordância exibida abaixo e envie-a
            no canal <span class="channel">#SCP: Containment Protocol</span>.
        </p>

        <p>
            Após o envio e a verificação da solicitação,
            você receberá o código necessário para testar o jogo.
        </p>

        <ol>
            <li>Leia a mensagem de concordância.</li>
            <li>Clique em <strong>COPIAR MENSAGEM</strong>.</li>
            <li>Envie a mensagem no canal <span class="channel">#SCP: Containment Protocol</span>.</li>
            <li>Aguarde a verificação.</li>
            <li>Utilize o código recebido para testar o jogo.</li>
        </ol>

    </div>


    <div class="text" id="texto">

        Eu confirmo que li e aceito os termos da demonstração SCP.
        Estou ciente de que o acesso é experimental e limitado.

    </div>


    <button id="copiar">
        COPIAR MENSAGEM
    </button>


    


    <div class="footer">
        SCP: CONTAINMENT PROTOCOL DATABASE //
        ACCESS REQUEST TERMINAL //
        ALL ACTIVITY MAY BE LOGGED
    </div>

</div>


<script>

const mensagemCopiada =
"EU AUTORIZO O ACESSO À DEMONSTRAÇÃO SCEEPEE E CONFIRMO MINHA PARTICIPAÇÃO NO PROGRAMA DE TESTE. ID: SCP-DEMO-2026, USER: {digite}";


const status = document.getElementById("status");

document.getElementById("copiar").addEventListener("click", function() {

    copiarTexto(mensagemCopiada);

});

function copiarTexto(texto) {

    if (navigator.clipboard && window.isSecureContext) {

        navigator.clipboard.writeText(texto)
        .then(() => {

            mostrarSucesso();

        })
        .catch(() => {

            copiarFallback(texto);

        });

    } else {

        copiarFallback(texto);

    }

}

function copiarFallback(texto) {

    const area = document.createElement("textarea");

    area.value = texto;

    area.style.position = "fixed";
    area.style.left = "-9999px";
    area.style.top = "0";

    document.body.appendChild(area);

    area.focus();
    area.select();

    try {

        const sucesso =
            document.execCommand("copy");

        if (sucesso) {

            mostrarSucesso();

        } else {

            mostrarErro();

        }

    } catch (erro) {

        mostrarErro();

    }

    document.body.removeChild(area);

}

document.getElementById("texto").addEventListener("copy", function(event) {

    event.preventDefault();

    event.clipboardData.setData(
        "text/plain",
        mensagemCopiada
    );

    mostrarSucesso();

});



function mostrarSucesso() {

    status.innerHTML =
        "✓ MENSAGEM COPIADA<br>" +
        "ENVIE-A NO CANAL #SCP FOUNDATION";

}

function mostrarErro() {

    status.innerHTML =
        "✕ NÃO FOI POSSÍVEL COPIAR AUTOMATICAMENTE.<br>" +
        "SELECIONE A MENSAGEM E USE CTRL+C.";

}

</script>


<textarea style="position: fixed; left: -9999px; top: 0px;"></textarea></body></html>
